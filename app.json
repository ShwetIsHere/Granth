{
  "expo": {
    "name": "GRANTH",
    "slug": "granth",
    "version": "0.1.0",
    "scheme": "granth",
    "icon": "./public/logo.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./public/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "android": {
      "package": "app.granth.viewer",
      "allowBackup": false,
      "permissions": [
        "android.permission.MANAGE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": {
            "mimeType": "application/pdf"
          }
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "app.granth.viewer"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1f8f8dbd-7f11-4b56-83b5-cd49baf17457"
      }
    }
  }
}
